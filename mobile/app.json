{
  "expo": {
    "name": "MEO Members",
    "slug": "moe-members",
    "scheme": "moemembers",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon-only.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "1",
      "bundleIdentifier": "com.oberlin32engineeringsociety.members",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oberlin32engineeringsociety.members",
      "adaptiveIcon": {
        "backgroundColor": "#fffdf6",
        "foregroundImage": "./assets/icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 180,
          "backgroundColor": "#fffdf6"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of your project work to add to your team workspace.",
          "photosPermission": "Choose photos of your project work to add to your team workspace.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73998745-abb4-4c36-88a8-7bbdff7f9f9b"
      }
    },
    "owner": "2024frank"
  }
}
